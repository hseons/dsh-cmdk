{
  "name": "dsh-cmdk",
  "version": "0.5.1",
  "type": "module",
  "description": "⌘K command palette for DeepSeek Harness: search sessions and message content (with message-level jumps), run commands, extend via providers.",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "command-palette",
    "search",
    "productivity",
    "full-text"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "screenshot.png",
    "screenshot-actions.png",
    "screenshot-ext.png",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/upgrade-plan.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "author": "mumuhmumu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hseons/dsh-cmdk.git"
  },
  "homepage": "https://github.com/hseons/dsh-cmdk#readme",
  "bugs": {
    "url": "https://github.com/hseons/dsh-cmdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
